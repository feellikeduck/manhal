# انسخ هذا الملف إلى .env وعبّه. لا ترفع .env إلى GitHub أبداً.

# Supabase > Connect > Session pooler (للسكربتات)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=
MANHAL_MODEL_GENERATE=gpt-6-astra
# مودل أرخص للتصنيف واستخراج النصوص (غيّره لأرخص مودل متاح لك)
MANHAL_MODEL_FAST=gpt-6-astra
MANHAL_MODEL_EMBED=text-embedding-3-small

# ترجمات QuranEnc (مفصولة بفواصل)، مثل: english_saheeh,urdu_junagarhi
QURANENC_KEYS=english_saheeh

# للاختبار (deno task eval)
MANHAL_API_URL=https://<project-ref>.supabase.co/functions/v1/manhal
MANHAL_TEST_KEY=
